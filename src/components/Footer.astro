---
import { site, labels } from '../utils/content';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <p class="footer-cta">
        <span class="loc-id">Mari bangun sesuatu yang </span>
        <span class="loc-en">Let's build something </span>
        <a href="#contact">
          <span class="loc-id">aman.</span>
          <span class="loc-en">secure.</span>
        </a>
      </p>

      <nav class="footer-links" aria-label="Tautan luar">
        <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={site.links.medium} target="_blank" rel="noopener">Medium</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span class="footer-mark">
        <b>heyrm</b>, {site.locationShort.id}
      </span>
      <span>
        © {year} ·
        <span class="loc-id">{labels.footer.rights.id}</span>
        <span class="loc-en">{labels.footer.rights.en}</span>
      </span>
    </div>
  </div>
</footer>
